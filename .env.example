# Lista de las claves que necesita la app, sin sus valores. Este archivo sí se sube a git.
# Cópialo a .env y escribe ahí los valores: .env nunca se sube a git.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
SESSION_SECRET=
# Código para crear cuenta. Vacío = registro cerrado (nadie más puede registrarse).
INVITE_CODE=
# true solo cuando la app se sirva por HTTPS.
COOKIE_SECURE=
# Recomendaciones con IA (Gemini). Vacías = desactivadas. Modelo más barato: gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=
